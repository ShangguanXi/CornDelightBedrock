{
  "include": [
    "../typescripts/**/*",
    "../scripts/data/mojang-effect.js"
  ],
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2020",
    "moduleResolution": "bundler",
    "module": "ES2020",
    "declaration": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "pretty": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noImplicitUseStrict": false,
    "outDir": "../scripts",
    "rootDir": "../typescripts",
    "paths": {
      "@minecraft/server": [
        "C:/Users/Administrator/AppData/Roaming/npm/node_modules/@minecraft/server"
      ],
      "@minecraft/vanilla-data": [
        "C:/Users/Administrator/AppData/Roaming/npm/node_modules/@minecraft/vanilla-data"
      ]
    },
    "listFiles": false,
  },
  "compileOnSave": false
}